# SQL Server (Prisma sqlserver format). Build from parts � never commit real passwords.
# Template: sqlserver://HOST:PORT;database=DB;user=USER;password=PASSWORD;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=TrainHub360;user=trainhub;password=REPLACE_ME;trustServerCertificate=true;encrypt=true"
JWT_SECRET="dev-secret"
PORT="4000"

SEED_ADMIN_EMAIL="admin@example.com"



# A.2 — where the app is served from. Activation and password-reset emails put this origin
# in front of their links; without it they would point at http://localhost:5173.
APP_BASE_URL="http://localhost:5173"

# A.2 — email transport. Leave unset (or "console") to log mail instead of sending it.
# Set to "smtp" with the SMTP_* values below to send real mail; a missing SMTP_HOST is an
# error, never a silent fall back to logging.
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM=""
