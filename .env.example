# SQL Server (Prisma sqlserver format). Build from parts � never commit real passwords.
# Template: sqlserver://HOST:PORT;database=DB;user=USER;password=PASSWORD;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=TrainHub360;user=trainhub;password=REPLACE_ME;trustServerCertificate=true;encrypt=true"
JWT_SECRET="dev-secret"
PORT="4000"

SEED_ADMIN_EMAIL="admin@example.com"



# A.2 — where the app is served from. Activation and password-reset emails put this origin
# in front of their links; without it they would point at http://localhost:5173.
APP_BASE_URL="http://localhost:5173"

# A.3 — file uploads (multipart). Where the local-disk storage provider writes, and the
# per-file cap in bytes (50 MB). The allowlist lives in lib/api/src/services/uploads.ts.
STORAGE_DIR=""
UPLOAD_MAX_BYTES="52428800"

# A.2 — email transport. Leave unset (or "console") to log mail instead of sending it.
# Set to "smtp" with the SMTP_* values below to send real mail; a missing SMTP_HOST is an
# error, never a silent fall back to logging.
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM=""

# A.2 gap 2 — production refuses to start when EMAIL_PROVIDER is not "smtp", or APP_BASE_URL
# is missing or points at localhost. EMAIL_STRICT=false is the deliberate opt-out, for a
# deployment that really does not send mail and accepts logging it.
EMAIL_STRICT="true"

# A.2 gap 8 — the login throttle: failures per account and per IP inside a sliding window.
# A locked-out login answers with the same generic 401 as a wrong password.
LOGIN_THROTTLE_ENABLED="true"
LOGIN_THROTTLE_WINDOW_MS="900000"
LOGIN_THROTTLE_ACCOUNT_LIMIT="5"
LOGIN_THROTTLE_IP_LIMIT="40"

# Round 8 / 3.2 — the real client address behind a reverse proxy. Off by default, so a
# spoofed X-Forwarded-For cannot choose its own login-throttle bucket. Set it to the
# number of trusted hops ("1"), "loopback", or a comma-separated list of proxy CIDRs.
# In production an unset value logs a startup warning: the throttle will then see the
# proxy's address for every request.
TRUST_PROXY=""
# Round 8 / 3.2 — LOGIN_THROTTLE_ENABLED=false is ignored in production unless this is
# set to "true", so a deployment cannot disable the throttle by accident.
LOGIN_THROTTLE_ALLOW_DISABLE="false"

# Round 8 / 4.1 — the reminder job runs every 15 minutes by default. Set a different
# interval in milliseconds, or 0 to turn it off explicitly.
REMINDER_INTERVAL_MS="900000"
