generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Organization {
  id                                   String    @id @default(cuid())
  name                                 String
  plan                                 String    @default("standard")
  learnerCount                         Float     @default(0) @map("learner_count")
  programmeCount                       Float     @default(0) @map("programme_count")
  reviewCreditModuleEnabled            Boolean   @default(false) @map("review_credit_module_enabled")
  reviewCreditMaxWeighting             Float     @default(10) @map("review_credit_max_weighting")
  reviewCreditPeriodStart              DateTime? @map("review_credit_period_start") @db.Date
  reviewCreditPeriodEnd                DateTime? @map("review_credit_period_end") @db.Date
  reviewCreditWeightAssessment         Float     @default(50) @map("review_credit_weight_assessment")
  reviewCreditWeightTimeliness         Float     @default(30) @map("review_credit_weight_timeliness")
  reviewCreditWeightApplication        Float     @default(20) @map("review_credit_weight_application")
  reviewCreditEligibleProgrammeTypes   String    @default("[]") @map("review_credit_eligible_programme_types")
  reviewCreditRequireManagerSignoff    Boolean   @default(true) @map("review_credit_require_manager_signoff")
  reviewCreditCollectApplicationScores Boolean   @default(true) @map("review_credit_collect_application_scores")
  webhookUrls  String    @default("[]") @map("webhook_urls") @db.NVarChar(Max)
  domain       String?   @db.NVarChar(256)
  domainVerified Boolean  @default(false) @map("domain_verified")
  domainVerificationToken String? @map("domain_verification_token") @db.NVarChar(128)
  samlEnabled  Boolean   @default(false) @map("saml_enabled")
  samlIdpCert  String?   @map("saml_idp_cert") @db.NVarChar(Max)
  samlIdpIssuer String?  @map("saml_idp_issuer") @db.NVarChar(512)
  samlEntityId String?   @map("saml_entity_id") @db.NVarChar(512)
  programmes                           Programme[]
  users                                User[]
  kpiSummaries                         KpiSummary[]
  cohorts                              Cohort[]
  sessions                             Session[]
  bookings                             Booking[]
  threads                              MessageThread[]
  calendarEvents                       CalendarEvent[]
  deleteRequests                       DeleteRequest[]

  @@map("organizations")
}

model Programme {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  type         String
  status       String       @default("active")
  learnerCount Float        @default(0) @map("learner_count")
  courseCount  Float        @default(0) @map("course_count")
  progress     Float        @default(0)
  owner        String
  budget       Float        @default(0)
  courses      Course[]
  enrolments   Enrolment[]
  threads      MessageThread[]
  sessions     Session[]   @relation("SessionProgramme")

  @@map("programmes")
}

model Course {
  id               String    @id @default(cuid())
  programmeId      String    @map("programme_id")
  programme        Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title            String
  category         String    @default("General")
  progress         Float     @default(0)
  status           String    @default("draft")
  appliedThreshold Float     @default(70) @map("applied_threshold")
  dueDate          String?   @map("due_date")
  trainer          String    @default("")
  duration         String?
  version          Int       @default(1)
  isArchived       Boolean   @default(false) @map("is_archived")
  archivedAt       DateTime? @map("archived_at")
  deletedAt        DateTime? @map("deleted_at")
  validityMonths   Int?      @map("validity_months")
  refresherCourseId String?  @map("refresher_course_id")
  modules          Module[]
  enrolments       Enrolment[]
  certificates     Certificate[]
  feedback         CourseFeedback[]
  bookings         Booking[]

  @@map("courses")
}

model Module {
  id        String       @id @default(cuid())
  courseId  String       @map("course_id")
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int          @default(0) @map("order_index")
  version   Int          @default(1)
  isArchived Boolean     @default(false) @map("is_archived")
  archivedAt DateTime?   @map("archived_at")
  deletedAt  DateTime?   @map("deleted_at")
  assessments Assessment[]

  @@map("modules")
}

model Assessment {
  id       String @id @default(cuid())
  moduleId String @map("module_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type     String @default("recall")
  maxScore Float  @default(100) @map("max_score")
  version   Int     @default(1)
  isArchived Boolean @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  @@map("assessments")
}

model Enrolment {
  id                          String     @id @default(cuid())
  learnerId                   String     @map("learner_id")
  learner                     User       @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId                    String     @map("course_id")
  course                      Course     @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programmeId                 String     @map("programme_id")
  programme                   Programme  @relation(fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status                      String     @default("enrolled")
  reviewCreditEligible        Boolean    @default(true) @map("review_credit_eligible")
  appliedAssessmentScore      Float?     @map("applied_assessment_score")
  completionDate              DateTime?  @map("completion_date")
  deadlineDate                DateTime?  @map("deadline_date")
  timelinessScore             Float?     @map("timeliness_score")
  applicationScore            Float?     @map("application_score")
  applicationScoreSubmittedBy String?    @map("application_score_submitted_by")
  applicationScoreSubmittedAt DateTime?  @map("application_score_submitted_at")
  enrolmentScore              Float?     @map("enrolment_score")
  reviewCreditExcluded        Boolean    @default(false) @map("review_credit_excluded")
  reviewCreditExcludeReason   String?    @map("review_credit_exclude_reason")
  reviewCreditLockedAt        DateTime?  @map("review_credit_locked_at")
  managerSignOff              Boolean?   @map("manager_sign_off")
  managerSignOffBy            String?    @map("manager_sign_off_by")
  managerSignOffAt            DateTime?  @map("manager_sign_off_at")
  createdAt                   DateTime   @default(now()) @map("created_at")

  @@map("enrolments")
}

model User {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String       @unique
  passwordHash String       @default("") @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  iCalFeedUrl  String?      @map("ical_feed_url") @db.NVarChar(1024)
  preferredNudgeDays String  @default("[\"MONDAY\",\"WEDNESDAY\",\"FRIDAY\"]") @map("preferred_nudge_days") @db.NVarChar(256)
  managerId String? @map("manager_id")
  manager   User?   @relation("Reports", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports   User[]  @relation("Reports")
  department String? @db.NVarChar(256)
  jobFunction String? @map("job_function") @db.NVarChar(256)
  enrolments   Enrolment[]
  roles        UserRole[]
  cohorts      CohortMember[]
  certificates Certificate[]
  rsvps        SessionRSVP[]
  feedback     CourseFeedback[]
  calendarConnections CalendarConnection[]
  recognitions Recognition[]
  resetTokens PasswordResetToken[]
  deleteRequestsMade DeleteRequest[] @relation("DeleteRequester")
  deleteRequestsApproved DeleteRequest[] @relation("DeleteApprover")
  sessionsAsTrainer Session[] @relation("SessionTrainer")
  bookingsAsTrainer Booking[] @relation("BookingTrainer")

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String  @map("role_id")
  role        Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  programmeId String? @map("programme_id")

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  timestamp DateTime @default(now())
  details   String?

  @@map("audit_logs")
}

model MessageThread {
  id          String    @id @default(cuid())
  subject     String
  context     String    @default("")
  participant String    @default("")
  programmeId String?   @map("programme_id")
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId       String    @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  urgent      Boolean   @default(false)
  slaBreached Boolean   @default(false) @map("sla_breached")
  slaHours              Int       @default(24) @map("sla_hours")
  lastLearnerMessageAt  DateTime? @map("last_learner_message_at")
  lastTrainerResponseAt DateTime? @map("last_trainer_response_at")
  isEscalated           Boolean   @default(false) @map("is_escalated")
  escalatedAt           DateTime? @map("escalated_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  messages    Message[]

  @@map("message_threads")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String        @map("thread_id")
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    String
  body      String        @db.NVarChar(Max)
  urgent    Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("messages")
}

model Booking {
  id          String  @id @default(cuid())
  trainer     String
  trainerId   String? @map("trainer_id")
  trainerRef  User?   @relation("BookingTrainer", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      String  @default("")
  courseId    String? @map("course_id")
  courseRef   Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId       String? @map("org_id")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        String
  time        String
  duration    String  @default("30m")
  status      String  @default("confirmed")
  meetingLink String? @map("meeting_link")

  @@map("bookings")
}

model DeleteRequest {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  targetName  String?   @map("target_name") @db.NVarChar(512)
  requestedBy String    @map("requested_by")
  requester   User      @relation("DeleteRequester", fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy  String?   @map("approved_by")
  approver    User?     @relation("DeleteApprover", fields: [approvedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  status      String    @default("pending")
  reason      String?   @db.NVarChar(1024)
  createdAt   DateTime  @default(now()) @map("created_at")
  decidedAt   DateTime? @map("decided_at")

  @@map("delete_requests")
}

model CalendarEvent {
  id          String  @id @default(cuid())
  title       String
  date        String
  time        String
  type        String  @default("session")
  accent      String  @default("blue")
  location    String?
  meetingLink String? @map("meeting_link")
  userId      String? @map("user_id")
  orgId       String  @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("calendar_events")
}

model KpiSummary {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  computedAt   DateTime     @default(now()) @map("computed_at")
  payload      String       @db.NVarChar(Max)

  @@map("kpi_summaries")
}

model ReviewCreditSetting {
  orgId            String @id @map("org_id")
  enabled          Int    @default(0)
  maxWeighting     Float  @default(10) @map("max_weighting")
  assessmentWeight Float  @default(50) @map("assessment_weight")
  timelinessWeight Float  @default(30) @map("timeliness_weight")
  applicationWeight Float @default(20) @map("application_weight")

  @@map("review_credit_settings")
}

model Cohort {
  id         String        @id @default(cuid())
  orgId      String        @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  department String?       @db.NVarChar(256)
  members    CohortMember[]

  @@map("cohorts")
}

model CohortMember {
  cohortId String @map("cohort_id")
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cohortId, userId])
  @@map("cohort_members")
}

model Certificate {
  id                String    @id @default(cuid())
  learnerId         String    @map("learner_id")
  learner           User      @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId          String    @map("course_id")
  course            Course    @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrolmentId       String?   @map("enrolment_id")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime? @map("expires_at")
  status            String    @default("active")
  certificateNumber String    @unique @default(cuid()) @map("certificate_number") @db.NVarChar(64)

  @@map("certificates")
}

model CourseFeedback {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learnerId   String   @map("learner_id")
  learner     User     @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating      Int
  comment     String?  @db.NVarChar(1024)
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@map("course_feedback")
}

model CalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  accessToken  String   @map("access_token") @db.NVarChar(Max)
  refreshToken String?  @map("refresh_token") @db.NVarChar(Max)
  calendarId   String?  @map("calendar_id") @db.NVarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("calendar_connections")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash") @db.NVarChar(128)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Recognition {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  awardedAt DateTime @default(now()) @map("awarded_at")
  context   String?  @db.NVarChar(1024)

  @@map("recognitions")
}

model Session {
  id        String @id @default(cuid())
  title     String
  programme String @default("")
  programmeId String? @map("programme_id")
  programmeRef Programme? @relation("SessionProgramme", fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId     String? @map("org_id")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trainer   String  @default("")
  trainerId String? @map("trainer_id")
  trainerRef User?  @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      String
  time      String
  mode      String @default("online")
  attendees Int    @default(0)
  status    String @default("scheduled")
  capacity  Int?
  rsvps     SessionRSVP[]

  @@map("sessions")
}

model SessionRSVP {
  id          String    @id @default(cuid())
  sessionId   String    @map("session_id")
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId   String    @map("learner_id")
  learner     User      @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String    @default("invited")
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("session_rsvps")
}

