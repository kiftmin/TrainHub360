generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Organization {
  id                                   String    @id @default(cuid())
  name                                 String
  plan                                 String    @default("standard")
  learnerCount                         Float     @default(0) @map("learner_count")
  programmeCount                       Float     @default(0) @map("programme_count")
  reviewCreditModuleEnabled            Boolean   @default(false) @map("review_credit_module_enabled")
  reviewCreditMaxWeighting             Float     @default(10) @map("review_credit_max_weighting")
  reviewCreditPeriodStart              DateTime? @map("review_credit_period_start") @db.Date
  reviewCreditPeriodEnd                DateTime? @map("review_credit_period_end") @db.Date
  reviewCreditWeightAssessment         Float     @default(50) @map("review_credit_weight_assessment")
  reviewCreditWeightTimeliness         Float     @default(30) @map("review_credit_weight_timeliness")
  reviewCreditWeightApplication        Float     @default(20) @map("review_credit_weight_application")
  reviewCreditEligibleProgrammeTypes   String    @default("[]") @map("review_credit_eligible_programme_types")
  reviewCreditRequireManagerSignoff    Boolean   @default(true) @map("review_credit_require_manager_signoff")
  reviewCreditCollectApplicationScores Boolean   @default(true) @map("review_credit_collect_application_scores")
  bulkRemovalThreshold Int      @default(5) @map("bulk_removal_threshold")
  reminderCadenceJson  String   @default("{\"unansweredHours\":[48,120],\"confirmedBeforeStartHours\":[24,1],\"maxUnanswered\":2}") @map("reminder_cadence_json") @db.NVarChar(Max)
  webhookUrls  String    @default("[]") @map("webhook_urls") @db.NVarChar(Max)
  domain       String?   @db.NVarChar(256)
  domainVerified Boolean  @default(false) @map("domain_verified")
  domainVerificationToken String? @map("domain_verification_token") @db.NVarChar(128)
  samlEnabled  Boolean   @default(false) @map("saml_enabled")
  samlIdpCert  String?   @map("saml_idp_cert") @db.NVarChar(Max)
  samlIdpIssuer String?  @map("saml_idp_issuer") @db.NVarChar(512)
  samlEntityId String?   @map("saml_entity_id") @db.NVarChar(512)
  programmes                           Programme[]
  storedFiles                          StoredFile[]
  users                                User[]
  kpiSummaries                         KpiSummary[]
  cohorts                              Cohort[]
  sessions                             Session[]
  bookings                             Booking[]
  threads                              MessageThread[]
  calendarEvents                       CalendarEvent[]
  deleteRequests                       DeleteRequest[]
  contentItems                         ContentItem[]
  notifications                        Notification[]

  @@map("organizations")
}

model Programme {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  type         String
  status       String       @default("active")
  learnerCount Float        @default(0) @map("learner_count")
  courseCount  Float        @default(0) @map("course_count")
  progress     Float        @default(0)
  owner        String
  budget       Float        @default(0)
  courses      Course[]
  enrolments   Enrolment[]
  threads      MessageThread[]
  sessions     Session[]   @relation("SessionProgramme")

  @@map("programmes")
}

model Course {
  id               String    @id @default(cuid())
  programmeId      String    @map("programme_id")
  programme        Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title            String
  category         String    @default("General")
  progress         Float     @default(0)
  status           String    @default("draft")
  appliedThreshold Float     @default(70) @map("applied_threshold")
  dueDate          String?   @map("due_date")
  trainer          String    @default("")
  trainerId        String?   @map("trainer_id")
  trainerRef       User?     @relation("CourseTrainer", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duration         String?
  version          Int       @default(1)
  isArchived       Boolean   @default(false) @map("is_archived")
  archivedAt       DateTime? @map("archived_at")
  deletedAt        DateTime? @map("deleted_at")
  validityMonths   Int?      @map("validity_months")
  refresherCourseId String?  @map("refresher_course_id")
  modules          Module[]
  enrolments       Enrolment[]
  certificates     Certificate[]
  feedback         CourseFeedback[]
  bookings         Booking[]
  sessions         Session[]     @relation("SessionCourse")

  @@map("courses")
}

model Module {
  id        String       @id @default(cuid())
  courseId  String       @map("course_id")
  course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int          @default(0) @map("order_index")
  version   Int          @default(1)
  isArchived Boolean     @default(false) @map("is_archived")
  archivedAt DateTime?   @map("archived_at")
  deletedAt  DateTime?   @map("deleted_at")
  assessments Assessment[]
  contentItems ContentItem[]

  @@map("modules")
}

// An assessment is edited in place while it is unpublished. Publishing freezes the current set of
// questions: an edit to a published row moves `publishedAt` aside, bumps `version` and copies the
// questions into a new row, so a past attempt stays attached to the questions it was graded
// against. "The live copy" is therefore one predicate: isPublished and publishedAt not null.
model Assessment {
  id       String @id @default(cuid())
  moduleId String @map("module_id")
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  // "recall" is objective only; "applied" must carry at least one scenario or short answer.
  type     String @default("recall")
  title    String @default("")
  maxScore Float  @default(100) @map("max_score")
  passMark Float? @map("pass_mark")
  maxAttempts Int? @map("max_attempts")
  timeLimitMinutes Int? @map("time_limit_minutes")
  isPublished Boolean @default(false) @map("is_published")
  // When the current question set was frozen; null once this row is superseded.
  publishedAt DateTime? @map("published_at")
  version   Int     @default(1)
  // The row this version continues from, so a chain can be walked either way.
  supersedesId String? @map("supersedes_id") @db.NVarChar(64)
  // Round 8 / 2.4: set when a later version goes live, so "live" = supersededAt null.
  // Existing attempts keep pointing at the version they started on.
  supersededAt DateTime? @map("superseded_at")
  supersededById String? @map("superseded_by_id")
  // Round 9 / 2.2: how the version that replaced the previous one was treated when it was
  // published. "minor" carries earlier results forward, "new_paper" does not. Null on a first
  // version and while a draft is still being edited.
  changeKind String? @map("change_kind")
  isArchived Boolean @default(false) @map("is_archived")
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")
  questions Question[]
  attempts  AssessmentAttempt[]

  @@index([moduleId])
  @@map("assessments")
}

model Question {
  id              String @id @default(cuid())
  assessmentId    String @map("assessment_id")
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order           Int    @default(0) @map("order_index")
  kind            String
  prompt          String @db.NVarChar(Max)
  scenarioContext String? @map("scenario_context") @db.NVarChar(Max)
  points          Float  @default(1)
  rubric          String? @db.NVarChar(Max)
  // Accepted forms for a short answer, as a JSON array, so an objective-enough answer can be
  // marked without a person. Empty means a person must mark it.
  acceptedAnswers String? @map("accepted_answers") @db.NVarChar(Max)
  options         QuestionOption[]
  answers         AttemptAnswer[]

  @@map("questions")
}

model QuestionOption {
  id         String @id @default(cuid())
  questionId String @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String @db.NVarChar(Max)
  isCorrect  Boolean @default(false) @map("is_correct")
  order      Int    @default(0) @map("order_index")

  @@map("question_options")
}

model AssessmentAttempt {
  id           String @id @default(cuid())
  assessmentId String @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrolmentId  String @map("enrolment_id")
  enrolment    Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  learnerId    String @map("learner_id")
  learner      User   @relation("AttemptLearner", fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attemptNumber Int   @default(1) @map("attempt_number")
  startedAt    DateTime @default(now()) @map("started_at")
  submittedAt  DateTime? @map("submitted_at")
  // in_progress -> submitted -> grading -> graded. A purely objective attempt goes straight to
  // graded on submit; anything with a scenario or short answer waits in grading for a person.
  status       String @default("in_progress")
  score        Float?
  maxScore     Float? @map("max_score")
  percent      Float?
  passed       Boolean?
  gradedBy     String? @map("graded_by")
  grader       User?   @relation("AttemptGrader", fields: [gradedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gradedAt     DateTime? @map("graded_at")
  answers      AttemptAnswer[]

  @@index([assessmentId, learnerId])
  @@index([status])
  @@map("assessment_attempts")
}

model AttemptAnswer {
  id             String @id @default(cuid())
  attemptId      String @map("attempt_id")
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String @map("question_id")
  question       Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // `answer` holds the text of a scenario or short answer; choice kinds keep their selection in
  // `optionIds`, so grading never parses JSON out of a string column.
  answer         String? @db.NVarChar(Max)
  optionIds      String? @map("option_ids") @db.NVarChar(Max)
  pointsAwarded  Float? @map("points_awarded")
  autoGraded     Boolean @default(false) @map("auto_graded")
  graderComment  String? @map("grader_comment") @db.NVarChar(Max)

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

// Round 9 / Phase 3.3. A course-wide re-evaluation is enqueued, not run inside the request that
// triggered it: publishing a paper or adding content used to loop over every enrolment inline.
// One row per course while a run is pending; the worker takes 50 enrolments per batch.
model EvaluationJob {
  id          String    @id @default(cuid())
  courseId    String    @map("course_id")
  trigger     String    @map("trigger_name")
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  processed   Int       @default(0)
  total       Int       @default(0)
  lastError   String?   @map("last_error") @db.NVarChar(Max)

  @@index([courseId, status])
  @@index([status, createdAt])
  @@map("evaluation_jobs")
}

model Enrolment {
  id                          String     @id @default(cuid())
  learnerId                   String     @map("learner_id")
  learner                     User       @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId                    String     @map("course_id")
  course                      Course     @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programmeId                 String     @map("programme_id")
  programme                   Programme  @relation(fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status                      String     @default("enrolled")
  reviewCreditEligible        Boolean    @default(true) @map("review_credit_eligible")
  appliedAssessmentScore      Float?     @map("applied_assessment_score")
  // Round 8 / 1.3: where the applied score came from and how a manual override is tracked.
  // [CONFIRM] default source is "assessment"; a manual PATCH needs a reason and is audited.
  appliedScoreSource          String     @default("assessment") @map("applied_score_source")
  appliedScoreOverrideReason  String?    @map("applied_score_override_reason") @db.NVarChar(Max)
  appliedScoreOverriddenBy    String?    @map("applied_score_overridden_by")
  appliedScoreOverriddenAt    DateTime?  @map("applied_score_overridden_at")
  pendingAssessmentScore      Float?     @map("pending_assessment_score")
  pendingAssessmentScoreAt    DateTime?  @map("pending_assessment_score_at")
  // Round 8 / 1.1: content completion is tracked separately from competence.
  contentCompletedAt          DateTime?  @map("content_completed_at")
  // Round 9 / 1.2: why this enrolment is completed. "assessment" is written by evaluateEnrolment
  // (content complete and every live applied assessment passed); "manual" by a staff override with
  // a reason. A certificate is never issued while this is null, so a status someone set by hand
  // cannot stand in for evidence.
  completionSource            String?    @map("completion_source")
  completionDate              DateTime?  @map("completion_date")
  deadlineDate                DateTime?  @map("deadline_date")
  timelinessScore             Float?     @map("timeliness_score")
  applicationScore            Float?     @map("application_score")
  applicationScoreSubmittedBy String?    @map("application_score_submitted_by")
  applicationScoreSubmittedAt DateTime?  @map("application_score_submitted_at")
  enrolmentScore              Float?     @map("enrolment_score")
  reviewCreditExcluded        Boolean    @default(false) @map("review_credit_excluded")
  reviewCreditExcludeReason   String?    @map("review_credit_exclude_reason")
  reviewCreditLockedAt        DateTime?  @map("review_credit_locked_at")
  managerSignOff              Boolean?   @map("manager_sign_off")
  managerSignOffBy            String?    @map("manager_sign_off_by")
  managerSignOffAt            DateTime?  @map("manager_sign_off_at")
  progress                    Float      @default(0)
  withdrawnAt                 DateTime?  @map("withdrawn_at")
  withdrawnBy                 String?    @map("withdrawn_by")
  createdAt                   DateTime   @default(now()) @map("created_at")
  contentProgress             ContentProgress[]
  attempts                    AssessmentAttempt[]

  @@map("enrolments")
}

model User {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id])
  name         String
  email        String       @unique
  passwordHash String       @default("") @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  iCalFeedUrl  String?      @map("ical_feed_url") @db.NVarChar(1024)
  preferredNudgeDays String  @default("[\"MONDAY\",\"WEDNESDAY\",\"FRIDAY\"]") @map("preferred_nudge_days") @db.NVarChar(256)
  isActive     Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")
  tokenVersion Int       @default(0) @map("token_version")
  activatedAt  DateTime? @map("activated_at")
  icalFeedToken String? @map("ical_feed_token") @db.NVarChar(128)
  managerId String? @map("manager_id")
  manager   User?   @relation("Reports", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports   User[]  @relation("Reports")
  department String? @db.NVarChar(256)
  jobFunction String? @map("job_function") @db.NVarChar(256)
  enrolments   Enrolment[]
  roles        UserRole[]
  cohorts      CohortMember[]
  certificates Certificate[]
  rsvps        SessionRSVP[]
  feedback     CourseFeedback[]
  calendarConnections CalendarConnection[]
  recognitions Recognition[]
  resetTokens PasswordResetToken[]
  deleteRequestsMade DeleteRequest[] @relation("DeleteRequester")
  deleteRequestsApproved DeleteRequest[] @relation("DeleteApprover")
  sessionsAsTrainer Session[] @relation("SessionTrainer")
  bookingsAsTrainer Booking[] @relation("BookingTrainer")
  coursesAsTrainer Course[] @relation("CourseTrainer")
  threadParticipants ThreadParticipant[]
  messagesAuthored Message[] @relation("MessageAuthor")
  notifications Notification[]
  contentVerified ContentProgress[] @relation("ContentVerifier")
  attempts AssessmentAttempt[] @relation("AttemptLearner")
  gradedAttempts AssessmentAttempt[] @relation("AttemptGrader")
  reminders ReminderLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(cuid())
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String  @map("role_id")
  role        Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  programmeId String? @map("programme_id")

  // Two limits, both deliberate (recorded 2026-11-20, with the baseline migration):
  //   - the surrogate `id` is the primary key, so a grant has a stable identity;
  //   - the old pair stays unique, so a person cannot hold the same role twice.
  // The pair, not the triple, is the limit: `@@unique([userId, roleId, programmeId])` cannot
  // enforce "same role in two programmes" on SQL Server anyway, because a NULL programme_id
  // compares as unknown and the unique index lets it through. Allowing a person to hold one role
  // in several programmes is a separate change to this line, and needs its own migration.
  @@unique([userId, roleId])
  @@index([programmeId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  timestamp DateTime @default(now())
  details   String?

  @@map("audit_logs")
}

model MessageThread {
  id          String    @id @default(cuid())
  subject     String
  context     String    @default("")
  participant String    @default("")
  programmeId String?   @map("programme_id")
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId       String    @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  urgent      Boolean   @default(false)
  slaBreached Boolean   @default(false) @map("sla_breached")
  slaHours              Int       @default(24) @map("sla_hours")
  lastLearnerMessageAt  DateTime? @map("last_learner_message_at")
  lastTrainerResponseAt DateTime? @map("last_trainer_response_at")
  isEscalated           Boolean   @default(false) @map("is_escalated")
  escalatedAt           DateTime? @map("escalated_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  messages    Message[]
  participants ThreadParticipant[]

  @@map("message_threads")
}

model ThreadParticipant {
  id       String   @id @default(cuid())
  threadId String   @map("thread_id")
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("learner")
  joinedAt DateTime @default(now()) @map("joined_at")
  // Round 8 / E.5: revoking access keeps the row for audit and can be restored.
  leftAt   DateTime? @map("left_at")
  leftReason String? @map("left_reason") @db.NVarChar(512)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String        @map("thread_id")
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    String
  authorId  String?       @map("author_id")
  authorRef User?         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  body      String        @db.NVarChar(Max)
  urgent    Boolean       @default(false)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("messages")
}

model Booking {
  id          String  @id @default(cuid())
  trainer     String
  trainerId   String? @map("trainer_id")
  trainerRef  User?   @relation("BookingTrainer", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  course      String  @default("")
  courseId    String? @map("course_id")
  courseRef   Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId       String? @map("org_id")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date        String
  time        String
  duration    String  @default("30m")
  status      String  @default("confirmed")
  meetingLink String? @map("meeting_link")

  @@map("bookings")
}

model DeleteRequest {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  targetName  String?   @map("target_name") @db.NVarChar(512)
  requestedBy String    @map("requested_by")
  requester   User      @relation("DeleteRequester", fields: [requestedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy  String?   @map("approved_by")
  approver    User?     @relation("DeleteApprover", fields: [approvedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  status      String    @default("pending")
  reason      String?   @db.NVarChar(1024)
  payload     String?   @db.NVarChar(Max)
  createdAt   DateTime  @default(now()) @map("created_at")
  decidedAt   DateTime? @map("decided_at")

  @@map("delete_requests")
}

model CalendarEvent {
  id          String  @id @default(cuid())
  title       String
  date        String
  time        String
  type        String  @default("session")
  accent      String  @default("blue")
  location    String?
  meetingLink String? @map("meeting_link")
  userId      String? @map("user_id")
  orgId       String  @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("calendar_events")
}

model KpiSummary {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  computedAt   DateTime     @default(now()) @map("computed_at")
  payload      String       @db.NVarChar(Max)

  @@map("kpi_summaries")
}

model ReviewCreditSetting {
  orgId            String @id @map("org_id")
  enabled          Int    @default(0)
  maxWeighting     Float  @default(10) @map("max_weighting")
  assessmentWeight Float  @default(50) @map("assessment_weight")
  timelinessWeight Float  @default(30) @map("timeliness_weight")
  applicationWeight Float @default(20) @map("application_weight")

  @@map("review_credit_settings")
}

model Cohort {
  id         String        @id @default(cuid())
  orgId      String        @map("org_id")
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String
  department String?       @db.NVarChar(256)
  members    CohortMember[]

  @@map("cohorts")
}

model CohortMember {
  cohortId String @map("cohort_id")
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([cohortId, userId])
  @@map("cohort_members")
}

model Certificate {
  id                String    @id @default(cuid())
  learnerId         String    @map("learner_id")
  learner           User      @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId          String    @map("course_id")
  course            Course    @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  enrolmentId       String?   @map("enrolment_id")
  // The applied attempt that made the learner competent, so a certificate points at its evidence
  // and not only at the enrolment.
  attemptId         String?   @map("attempt_id")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  expiresAt         DateTime? @map("expires_at")
  status            String    @default("active")
  certificateNumber String    @unique @default(cuid()) @map("certificate_number") @db.NVarChar(64)

  @@index([learnerId])
  @@map("certificates")
}

model CourseFeedback {
  id          String   @id @default(cuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learnerId   String   @map("learner_id")
  learner     User     @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating      Int
  comment     String?  @db.NVarChar(1024)
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@map("course_feedback")
}

model CalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String
  accessToken  String   @map("access_token") @db.NVarChar(Max)
  refreshToken String?  @map("refresh_token") @db.NVarChar(Max)
  calendarId   String?  @map("calendar_id") @db.NVarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("calendar_connections")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @map("token_hash") @db.NVarChar(128)
  purpose   String   @default("password_reset")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tokenHash, purpose])

  @@map("password_reset_tokens")
}

model Recognition {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  awardedAt DateTime @default(now()) @map("awarded_at")
  context   String?  @db.NVarChar(1024)

  @@map("recognitions")
}

model Session {
  id        String @id @default(cuid())
  title     String
  programme String @default("")
  programmeId String? @map("programme_id")
  programmeRef Programme? @relation("SessionProgramme", fields: [programmeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId     String? @map("org_id")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trainer   String  @default("")
  trainerId String? @map("trainer_id")
  trainerRef User?  @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId  String? @map("course_id")
  courseRef Course? @relation("SessionCourse", fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  date      String
  time      String
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  timezone  String @default("UTC")
  joinUrl   String? @map("join_url") @db.NVarChar(1024)
  location  String? @db.NVarChar(512)
  mode      String @default("online")
  attendees Int    @default(0)
  status    String @default("scheduled")
  capacity  Int?
  // Round 8 / D.2: bumped whenever the event changes so calendar clients update.
  sequence  Int    @default(0)
  rsvps     SessionRSVP[]
  reminders ReminderLog[]

  @@map("sessions")
}

model SessionRSVP {
  id          String    @id @default(cuid())
  sessionId   String    @map("session_id")
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId   String    @map("learner_id")
  learner     User      @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status      String    @default("invited")
  respondedAt DateTime? @map("responded_at")
  // Round 8 / E.7: promotion must follow when the learner joined the waitlist.
  waitlistedAt DateTime? @map("waitlisted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([sessionId, learnerId])
  @@map("session_rsvps")
}

model ContentItem {
  id               String  @id @default(cuid())
  orgId            String  @map("org_id")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  moduleId         String  @map("module_id")
  module           Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type             String
  title            String
  description      String? @db.NVarChar(Max)
  order            Int     @default(0) @map("order_index")
  required         Boolean @default(true)
  estimatedMinutes Int?    @map("estimated_minutes")
  body             String? @db.NVarChar(Max)
  storageKey       String? @map("storage_key") @db.NVarChar(512)
  // A.3: the org-bound upload this item points at. Null for rows created before A.3.
  storedFileId     String? @map("stored_file_id")
  storedFile       StoredFile? @relation(fields: [storedFileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fileName         String? @map("file_name") @db.NVarChar(512)
  mimeType         String? @map("mime_type") @db.NVarChar(256)
  sizeBytes        Int?    @map("size_bytes")
  checksum         String? @db.NVarChar(128)
  url              String? @db.NVarChar(1024)
  provider         String? @db.NVarChar(64)
  completionMode   String  @default("trainer_verified") @map("completion_mode")
  version          Int     @default(1)
  isArchived       Boolean @default(false) @map("is_archived")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime @default(now()) @map("created_at")
  progress         ContentProgress[]

  @@index([moduleId])
  @@index([orgId])
  @@index([storedFileId])
  @@map("content_items")
}

model ContentProgress {
  id             String    @id @default(cuid())
  enrolmentId    String    @map("enrolment_id")
  enrolment      Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contentItemId  String    @map("content_item_id")
  contentItem    ContentItem @relation(fields: [contentItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status         String    @default("not_started")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  evidenceNote   String?   @map("evidence_note") @db.NVarChar(Max)
  evidenceFileKey String?  @map("evidence_file_key") @db.NVarChar(512)
  // A.3: the org-bound upload a learner attached as proof. Null for older rows.
  evidenceFileId  String?  @map("evidence_file_id")
  evidenceFile    StoredFile? @relation("ProgressEvidence", fields: [evidenceFileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedBy     String?   @map("verified_by")
  verifier       User?     @relation("ContentVerifier", fields: [verifiedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  verifiedAt     DateTime? @map("verified_at")

  @@unique([enrolmentId, contentItemId])
  @@map("content_progress")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId     String?  @map("org_id")
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type      String
  title     String
  body      String?  @db.NVarChar(Max)
  link      String?  @db.NVarChar(1024)
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// Round 7 gap 3: a send that failed used to vanish (`.catch(() => false)`). One row per
// failure, so an operator can see that mail is not going out without reading debug logs.
model EmailFailure {
  id          String   @id @default(cuid())
  to          String   @db.NVarChar(320)
  subject     String   @db.NVarChar(512)
  kind        String   @db.NVarChar(64)
  error       String   @db.NVarChar(1000)
  userId      String?  @map("user_id")
  orgId       String?  @map("org_id")
  contextJson String?  @map("context_json") @db.NVarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([orgId, createdAt])
  @@map("email_failures")
}

// Round 6 / A.3: org-bound file ids.
//
// A file used to exist only as a `storageKey` string copied from an upload response into a
// content item or a progress record. Nothing tied that string to the organization that
// uploaded it, so an id from another tenant could be reused, and a made-up key was accepted
// as if it had been uploaded. A StoredFile row is now the only thing a content item or a
// progress record may point at, and it carries the org, the uploader and the checksum.
model StoredFile {
  id            String   @id @default(cuid())
  orgId         String   @map("org_id")
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uploadedById  String?  @map("uploaded_by_id")
  storageKey    String   @unique @map("storage_key") @db.NVarChar(512)
  fileName      String   @map("file_name") @db.NVarChar(512)
  mimeType      String   @map("mime_type") @db.NVarChar(256)
  sizeBytes     Int      @map("size_bytes")
  checksum      String   @db.NVarChar(128)
  // Which upload path produced it: "content" (a module file) or "evidence" (progress proof).
  purpose       String   @default("content") @db.NVarChar(32)
  createdAt     DateTime @default(now()) @map("created_at")
  contentItems  ContentItem[]
  progressEvidence ContentProgress[] @relation("ProgressEvidence")

  @@index([orgId, createdAt])
  @@map("stored_files")
}

model ReminderLog {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learnerId String   @map("learner_id")
  learner   User     @relation(fields: [learnerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  kind      String
  sentAt    DateTime @default(now()) @map("sent_at")

  @@unique([sessionId, learnerId, kind])
  @@map("reminder_logs")
}

